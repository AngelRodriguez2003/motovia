# URL pública del sitio (para sitemap y metadatos)
NEXT_PUBLIC_SITE_URL=https://motovia.co

# AdSense (opcional). Sin estos valores se muestra el espacio "Tu negocio aquí".
# Las viñetas de pantalla completa se activan desde la consola de AdSense (Anuncios automáticos).
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_FICHA=
NEXT_PUBLIC_ADSENSE_SLOT_APRENDE=

# Tiempo mínimo de uso antes del anuncio propio de pantalla completa (ms). Por defecto 180000 (3 min).
NEXT_PUBLIC_INTERSTICIAL_MS=
